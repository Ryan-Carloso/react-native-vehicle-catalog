{
  "name": "react-native-vehicle-catalog",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.27.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "preinstall": "npx -y only-allow pnpm",
    "dev:ios": "pnpm --filter frontend ios",
    "dev:android": "pnpm --filter frontend android",
    "dev:web": "pnpm --filter frontend web",
    "dev:backend": "pnpm --filter backend start",
    "lint": "pnpm --filter frontend lint",
    "lint:fix": "pnpm --filter frontend lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.8.1"
  }
}
